---
import { useTranslations, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="section wrap split" aria-labelledby="about-title">
  <header class="section-head">
    <p class="section-index">03</p>
    <h2 id="about-title" class="section-title">{t('about.title')}</h2>
  </header>

  <div class="content">
    <div class="bio">
      {profile.about[lang].map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="now">
      <h3 class="label">{t('about.now')}</h3>
      <ul class="card">
        {profile.now[lang].map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .content {
    display: grid;
    gap: 3rem;
  }

  .bio {
    display: grid;
    gap: 1.1em;
    max-width: 40ch;
    font-size: var(--step-2);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .bio p + p {
    color: var(--ink-2);
  }

  .now ul {
    margin-top: 1rem;
    padding: 0.25rem 1.25rem;
  }

  .now li {
    display: flex;
    gap: 0.9rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .now li:last-child {
    border-bottom: 0;
  }

  .now li::before {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.6em;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
