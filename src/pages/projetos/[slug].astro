---
import ProjectPage from '../../components/ProjectPage.astro';
import { getProjects, slugOf, type Project } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects('pt');
  return projects.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

interface Props {
  entry: Project;
}

const { entry } = Astro.props;
---

<ProjectPage lang="pt" entry={entry} />
